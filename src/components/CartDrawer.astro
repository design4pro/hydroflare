---
// Accessible cart drawer, rendered once in the root layout on every page.
// Opened via the navbar trigger or window.Shopify.actions.openCart().
---

<dialog id="cart-drawer" aria-labelledby="cart-drawer-title" closedby="any">
  <div class="drawer__header">
    <h2 id="cart-drawer-title">Cart</h2>
    <button type="button" class="drawer__close" aria-label="Close cart" data-close-cart>
      Close
    </button>
  </div>
  <div class="drawer__banner" id="cart-drawer-banner"></div>
  <div class="drawer__body" id="cart-drawer-lines"></div>
  <div class="drawer__footer" id="cart-drawer-footer"></div>
</dialog>

<script>
  import { mountCart } from "../scripts/cart";

  const drawer = document.getElementById("cart-drawer") as HTMLDialogElement | null;
  const closeBtn = document.querySelector("[data-close-cart]");

  function openCartDrawer() {
    drawer?.showModal();
  }
  function closeCartDrawer() {
    drawer?.close();
  }

  closeBtn?.addEventListener("click", closeCartDrawer);

  // Register this drawer as the handler for the Standard Actions openCart action
  // so window.Shopify.actions.openCart() (and external integrations) open it.
  function configureOpenCart(): boolean {
    const openCart = (window as any).Shopify?.actions?.openCart;
    if (!openCart || typeof openCart.configure !== "function") return false;
    openCart.configure({ handler: openCartDrawer });
    return true;
  }
  if (!configureOpenCart()) {
    document.addEventListener("DOMContentLoaded", () => configureOpenCart(), {
      once: true,
    });
  }

  // Upgrade the navbar cart link(s) to open the drawer instead of navigating.
  document.querySelectorAll("[data-cart-trigger]").forEach((el) => {
    el.addEventListener("click", (event) => {
      event.preventDefault();
      openCartDrawer();
    });
  });

  // Render the shared cart into the drawer. mountCart creates/fetches the shared
  // store on first use and repaints on every state change.
  const linesEl = document.getElementById("cart-drawer-lines");
  if (linesEl) {
    mountCart(null, {
      bannerEl: document.getElementById("cart-drawer-banner"),
      linesEl,
      footerEl: document.getElementById("cart-drawer-footer"),
    });
  }
</script>
