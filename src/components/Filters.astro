---
import {
  serializeCollectionParams,
  isFilterInputActive,
  type ProductFilter,
} from "@shopify/hydrogen";

interface FilterValueShape {
  id: string;
  label: string;
  count?: number | null;
  input: string;
}
interface FilterShape {
  id: string;
  label: string;
  type: string;
  values: FilterValueShape[];
}
interface Props {
  filters: FilterShape[];
  activeFilters: ProductFilter[];
}
const { filters, activeFilters } = Astro.props;

// A filter value's checkbox name/value come from serializing a single filter
// (its `input` JSON parsed to a ProductFilter) — the authoritative identity.
// Do not derive field names from labels, ids, or types.
function field(input: string): { name: string; value: string } {
  const single = JSON.parse(input) as ProductFilter;
  const params = serializeCollectionParams({
    filters: [single],
    sortKey: undefined,
    reverse: false,
  });
  const entry = [...params.entries()][0];
  return entry ? { name: entry[0], value: entry[1] } : { name: "", value: "" };
}
---

{
  filters.map((group) => (
    <fieldset class="filter-group">
      <legend class="filter-group__label">{group.label}</legend>
      {group.values.map((value) => {
        const { name, value: val } = field(value.input);
        const id = `${group.id}-${value.id}`;
        const checked = isFilterInputActive(activeFilters, value.input);
        return (
          <label class="filter-value" for={id}>
            <input
              id={id}
              type="checkbox"
              name={name}
              value={val}
              checked={checked}
            />
            <span>{value.label}</span>
            {value.count != null && (
              <span class="filter-value__count">({value.count})</span>
            )}
          </label>
        );
      })}
    </fieldset>
  ))
}

<style>
  .filter-group {
    border: 0;
    border-top: 1px solid #eee;
    margin: 0;
    padding: 0.75rem 0;
  }
  .filter-group__label {
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0;
    margin-bottom: 0.5rem;
  }
  .filter-value {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0;
    font-size: 0.9rem;
    cursor: pointer;
  }
  .filter-value__count {
    color: #999;
  }
</style>
