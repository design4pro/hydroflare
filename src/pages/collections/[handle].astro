---
import { gql } from "@shopify/hydrogen";
import {
  parseCollectionParams,
  getSortByValue,
  getFilterRemovalUrl,
  serializeCollectionParams,
  type ProductFilter,
} from "@shopify/hydrogen";
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import Filters from "../../components/Filters.astro";

const COLLECTION_QUERY = gql(`
  query CollectionDetails(
    $handle: String!
    $country: CountryCode
    $language: LanguageCode
    $first: Int
    $filters: [ProductFilter!]
    $sortKey: ProductCollectionSortKeys
    $reverse: Boolean
  ) @inContext(country: $country, language: $language) {
    collection(handle: $handle) {
      id
      title
      description
      products(
        first: $first
        filters: $filters
        sortKey: $sortKey
        reverse: $reverse
      ) {
        filters {
          id
          label
          type
          values {
            id
            label
            count
            input
          }
        }
        nodes {
          id
          title
          handle
          featuredImage {
            url
            altText
          }
          priceRange {
            minVariantPrice {
              amount
              currencyCode
            }
            maxVariantPrice {
              amount
              currencyCode
            }
          }
        }
      }
    }
  }
`);

const parsed = parseCollectionParams(Astro.url.searchParams);

const { data } = await Astro.locals.storefront.graphql(COLLECTION_QUERY, {
  variables: {
    handle: Astro.params.handle!,
    first: 24,
    filters: parsed.filters as any,
    sortKey: parsed.sortKey,
    reverse: parsed.reverse,
  },
});

const collection = data?.collection;
if (!collection) {
  Astro.response.status = 404;
}

const products = collection?.products?.nodes ?? [];
const availableFilters = collection?.products?.filters ?? [];

const SORT_OPTIONS = [
  { label: "Featured", sortKey: "MANUAL", reverse: false },
  { label: "Price: Low to High", sortKey: "PRICE", reverse: false },
  { label: "Price: High to Low", sortKey: "PRICE", reverse: true },
  { label: "Best Selling", sortKey: "BEST_SELLING", reverse: false },
  { label: "Newest", sortKey: "CREATED", reverse: true },
  { label: "Title: A-Z", sortKey: "TITLE", reverse: false },
] as const;

const currentSortValue =
  parsed.sortKey != null ? getSortByValue(parsed.sortKey, parsed.reverse) : "";

// Match an active filter to its display label via the serialized param form
// (robust to JSON key ordering).
function filterKey(f: ProductFilter): string {
  return [...serializeCollectionParams({
    filters: [f],
    sortKey: undefined,
    reverse: false,
  }).entries()].map(([k, v]) => `${k}=${v}`).join("&");
}
function labelForFilter(f: ProductFilter): string {
  for (const group of availableFilters) {
    for (const value of group.values) {
      if (filterKey(JSON.parse(value.input) as ProductFilter) === filterKey(f)) {
        return value.label;
      }
    }
  }
  return "Filter";
}
---

<Layout>
  <main class="container">
    {
      collection ? (
        <>
          <header class="header">
            <h1 class="header__title">{collection.title}</h1>
            {collection.description && (
              <div class="header__desc" set:html={collection.description} />
            )}
          </header>

          <div class="layout">
            <aside class="sidebar">
              <form
                method="get"
                action={Astro.url.pathname}
                data-filters-form
                class="filters-form"
              >
                <label class="sort">
                  <span>Sort by</span>
                  <select name="sort_by">
                    {SORT_OPTIONS.map((opt) => (
                      <option
                        value={getSortByValue(opt.sortKey, opt.reverse)}
                        selected={
                          getSortByValue(opt.sortKey, opt.reverse) ===
                          currentSortValue
                        }
                      >
                        {opt.label}
                      </option>
                    ))}
                  </select>
                </label>

                <Filters filters={availableFilters} activeFilters={parsed.filters} />

                <noscript>
                  <button type="submit" class="apply">Apply filters</button>
                </noscript>
              </form>
            </aside>

            <section class="results">
              {parsed.filters.length > 0 && (
                <div class="chips">
                  {parsed.filters.map((f) => (
                    <a
                      class="chip"
                      href={getFilterRemovalUrl(Astro.url.searchParams, f)}
                    >
                      {labelForFilter(f)} ✕
                    </a>
                  ))}
                </div>
              )}

              <p class="count">
                {products.length} product{products.length === 1 ? "" : "s"}
              </p>

              {products.length === 0 ? (
                <p class="empty">No products match these filters.</p>
              ) : (
                <div class="product-grid">
                  {products.map((product) => (
                    <ProductCard product={product} />
                  ))}
                </div>
              )}
            </section>
          </div>
        </>
      ) : (
        <div class="not-found">
          <h1>Collection not found</h1>
          <p>
            <a href="/collections">Browse all collections</a>
          </p>
        </div>
      )
    }
  </main>
</Layout>

{
  collection && (
    <div
      id="collection-analytics"
      data-id={collection.id}
      data-title={collection.title}
      data-handle={Astro.params.handle}
      hidden
    />
  )
}

<script>
  // Progressive enhancement: submit the browse form when any input changes.
  const form = document.querySelector<HTMLFormElement>("form[data-filters-form]");
  form?.addEventListener("change", () => form.requestSubmit());
</script>

<script>
  import { initAnalyticsFromDom, getAnalytics, AnalyticsEvent } from "../../lib/analytics";
  const shop = initAnalyticsFromDom();
  const analytics = getAnalytics();
  const el = document.getElementById("collection-analytics");
  if (el && analytics && shop) {
    analytics.publish(AnalyticsEvent.COLLECTION_VIEWED, {
      collection: {
        id: el.dataset.id ?? "",
        handle: el.dataset.handle ?? "",
      },
      url: window.location.href,
      shop,
    });
  }
</script>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
  }
  .header__title {
    font-size: 1.75rem;
    margin: 0 0 0.5rem;
  }
  .header__desc {
    color: #555;
    margin: 0 0 1.5rem;
    max-width: 60ch;
  }
  .layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 2rem;
    align-items: start;
  }
  @media (max-width: 720px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
  .filters-form {
    position: sticky;
    top: 1rem;
  }
  .sort {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.8rem;
    color: #555;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #eee;
    margin-bottom: 0.25rem;
  }
  .sort select {
    padding: 0.4rem;
    font-size: 0.9rem;
  }
  .apply {
    margin-top: 1rem;
    padding: 0.5rem 0.75rem;
    cursor: pointer;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .chip {
    text-decoration: none;
    background: #f0f0f0;
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
    font-size: 0.8rem;
    color: #333;
  }
  .count {
    color: #777;
    font-size: 0.85rem;
    margin: 0 0 1rem;
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }
  .empty {
    color: #777;
  }
  .not-found {
    text-align: center;
    padding: 3rem 0;
  }
</style>
