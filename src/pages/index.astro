---
import { gql } from "@shopify/hydrogen";
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";

const HOMEPAGE_QUERY = gql(`
  query Homepage {
    shop {
      name
    }
    collections(first: 6) {
      nodes {
        id
        title
        handle
        image {
          url
          altText
        }
      }
    }
    products(first: 12) {
      nodes {
        id
        title
        handle
        featuredImage {
          url
          altText
        }
        priceRange {
          minVariantPrice {
            amount
            currencyCode
          }
          maxVariantPrice {
            amount
            currencyCode
          }
        }
      }
    }
  }
`);

const { data, errors } = await Astro.locals.storefront.graphql(HOMEPAGE_QUERY);

const shop = data?.shop;
const collections = data?.collections?.nodes ?? [];
const products = data?.products?.nodes ?? [];
---

<Layout>
  <main class="container">
    <header class="home-header">
      <h1>{shop?.name ?? "Store"}</h1>
    </header>

    {
      errors && (
        <p class="error" role="alert">
          Couldn’t load store data right now. Please try again.
        </p>
      )
    }

    <section class="section">
      <h2 class="section__title">Collections</h2>
      {
        collections.length === 0 ? (
          <p class="empty">No collections yet.</p>
        ) : (
          <ul class="collection-grid">
            {collections.map((collection) => (
              <li>
                <a class="collection-card" href={`/collections/${collection.handle}`}>
                  {collection.image?.url ? (
                    <img
                      src={collection.image.url}
                      alt={collection.image.altText ?? collection.title}
                      loading="lazy"
                    />
                  ) : (
                    <span class="collection-card__placeholder" />
                  )}
                  <span class="collection-card__title">{collection.title}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="section">
      <h2 class="section__title">Products</h2>
      {
        products.length === 0 ? (
          <p class="empty">No products yet.</p>
        ) : (
          <div class="product-grid">
            {products.map((product) => (
              <ProductCard product={product} />
            ))}
          </div>
        )
      }
    </section>
  </main>
</Layout>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
  }
  .home-header h1 {
    font-size: 1.75rem;
    margin: 0 0 1.5rem;
  }
  .section {
    margin-bottom: 2.5rem;
  }
  .section__title {
    font-size: 1.25rem;
    margin: 0 0 1rem;
  }
  .collection-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1rem;
  }
  .collection-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid #eee;
    border-radius: 8px;
    overflow: hidden;
  }
  .collection-card img,
  .collection-card__placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background: #fafafa;
  }
  .collection-card__title {
    display: block;
    padding: 0.6rem;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }
  .error {
    color: #b00020;
  }
  .empty {
    color: #777;
  }
</style>
