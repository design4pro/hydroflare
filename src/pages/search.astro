---
import { gql } from "@shopify/hydrogen";
import {
  parseCollectionParams,
  getSortByValue,
  getFilterRemovalUrl,
  serializeCollectionParams,
  normalizeCollectionSearch,
  type ProductFilter,
} from "@shopify/hydrogen";
import Layout from "../layouts/Layout.astro";
import ProductCard, { type ProductCardProduct } from "../components/ProductCard.astro";
import Filters from "../components/Filters.astro";

const SEARCH_QUERY = gql(`
  query Search(
    $query: String!
    $country: CountryCode
    $language: LanguageCode
    $first: Int
    $filters: [ProductFilter!]
    $sortKey: SearchSortKeys
    $reverse: Boolean
  ) @inContext(country: $country, language: $language) {
    search(
      query: $query
      first: $first
      productFilters: $filters
      sortKey: $sortKey
      reverse: $reverse
    ) {
      productFilters {
        id
        label
        type
        values {
          id
          label
          count
          input
        }
      }
      edges {
        node {
          ... on Product {
            id
            title
            handle
            featuredImage {
              url
              altText
            }
            priceRange {
              minVariantPrice {
                amount
                currencyCode
              }
              maxVariantPrice {
                amount
                currencyCode
              }
            }
          }
        }
      }
    }
  }
`);

const rawTerm = Astro.url.searchParams.get("q") ?? "";
const term = normalizeCollectionSearch(rawTerm);
const parsed = parseCollectionParams(Astro.url.searchParams);

// search supports only PRICE/RELEVANCE; map anything else back to RELEVANCE.
const searchSortKey = parsed.sortKey === "PRICE" ? "PRICE" : "RELEVANCE";
const reverse = searchSortKey === "PRICE" ? parsed.reverse : false;

let products: ProductCardProduct[] = [];
let availableFilters: { id: string; label: string; type: string; values: { id: string; label: string; count?: number | null; input: string }[] }[] = [];

if (term) {
  const { data } = await Astro.locals.storefront.graphql(SEARCH_QUERY, {
    variables: {
      query: term,
      first: 24,
      filters: parsed.filters as any,
      sortKey: searchSortKey,
      reverse,
    },
  });
  products = ((data?.search?.edges ?? [])
    .map((e) => e.node)
    .filter((n) => n && "handle" in n)) as unknown as ProductCardProduct[];
  availableFilters = (data?.search?.productFilters ?? []) as typeof availableFilters;
}

const SORT_OPTIONS = [
  { label: "Relevance", sortKey: "RELEVANCE", reverse: false },
  { label: "Price: Low to High", sortKey: "PRICE", reverse: false },
  { label: "Price: High to Low", sortKey: "PRICE", reverse: true },
] as const;

const currentSortValue =
  parsed.sortKey === "PRICE" ? getSortByValue("PRICE", reverse) : getSortByValue("RELEVANCE", false);

function filterKey(f: ProductFilter): string {
  return [...serializeCollectionParams({
    filters: [f],
    sortKey: undefined,
    reverse: false,
  }).entries()].map(([k, v]) => `${k}=${v}`).join("&");
}
function labelForFilter(f: ProductFilter): string {
  for (const group of availableFilters) {
    for (const value of group.values) {
      if (filterKey(JSON.parse(value.input) as ProductFilter) === filterKey(f)) {
        return value.label;
      }
    }
  }
  return "Filter";
}
---

<Layout>
  <main class="container">
    <h1 class="title">Search</h1>

    <form method="get" action="/search" class="search-box">
      <input
        type="search"
        name="q"
        value={rawTerm}
        placeholder="Search products…"
        autocomplete="off"
      />
      <button type="submit">Search</button>
    </form>

    {
      term && (
        <div class="layout">
          <aside class="sidebar">
            <form method="get" action="/search" data-filters-form class="filters-form">
              <input type="hidden" name="q" value={rawTerm} />
              <label class="sort">
                <span>Sort by</span>
                <select name="sort_by">
                  {SORT_OPTIONS.map((opt) => (
                    <option
                      value={getSortByValue(opt.sortKey, opt.reverse)}
                      selected={
                        getSortByValue(opt.sortKey, opt.reverse) === currentSortValue
                      }
                    >
                      {opt.label}
                    </option>
                  ))}
                </select>
              </label>

              <Filters filters={availableFilters} activeFilters={parsed.filters} />

              <noscript>
                <button type="submit" class="apply">Apply filters</button>
              </noscript>
            </form>
          </aside>

          <section class="results">
            {parsed.filters.length > 0 && (
              <div class="chips">
                {parsed.filters.map((f) => (
                  <a class="chip" href={getFilterRemovalUrl(Astro.url.searchParams, f)}>
                    {labelForFilter(f)} ✕
                  </a>
                ))}
              </div>
            )}

            <p class="count">
              {products.length} result{products.length === 1 ? "" : "s"} for “{rawTerm}”
            </p>

            {products.length === 0 ? (
              <p class="empty">No products found. Try a different term or filter.</p>
            ) : (
              <div class="product-grid">
                {products.map((product) => (
                  <ProductCard product={product} />
                ))}
              </div>
            )}
          </section>
        </div>
      )
    }

    {
      !term && (
        <p class="empty">Search for products by name, type, or description.</p>
      )
    }
  </main>
</Layout>

<div id="search-analytics" data-term={rawTerm} hidden></div>

<script>
  const form = document.querySelector<HTMLFormElement>("form[data-filters-form]");
  form?.addEventListener("change", () => form.requestSubmit());
</script>

<script>
  import { initAnalyticsFromDom, getAnalytics, AnalyticsEvent } from "../lib/analytics";
  const shop = initAnalyticsFromDom();
  const analytics = getAnalytics();
  const el = document.getElementById("search-analytics");
  const term = el?.dataset.term ?? "";
  if (analytics && shop && term) {
    analytics.publish(AnalyticsEvent.SEARCH_VIEWED, {
      searchTerm: term,
      url: window.location.href,
      shop,
    });
  }
</script>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
  }
  .title {
    font-size: 1.75rem;
    margin: 0 0 1rem;
  }
  .search-box {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .search-box input {
    flex: 1;
    padding: 0.55rem 0.7rem;
    font-size: 1rem;
  }
  .search-box button {
    padding: 0.55rem 1rem;
    cursor: pointer;
  }
  .layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 2rem;
    align-items: start;
  }
  @media (max-width: 720px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
  .filters-form {
    position: sticky;
    top: 1rem;
  }
  .sort {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.8rem;
    color: #555;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #eee;
    margin-bottom: 0.25rem;
  }
  .sort select {
    padding: 0.4rem;
    font-size: 0.9rem;
  }
  .apply {
    margin-top: 1rem;
    padding: 0.5rem 0.75rem;
    cursor: pointer;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .chip {
    text-decoration: none;
    background: #f0f0f0;
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
    font-size: 0.8rem;
    color: #333;
  }
  .count {
    color: #777;
    font-size: 0.85rem;
    margin: 0 0 1rem;
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }
  .empty {
    color: #777;
  }
</style>
