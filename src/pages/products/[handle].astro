---
import { gql, getSelectedProductOptions } from "@shopify/hydrogen";
import Layout from "../../layouts/Layout.astro";
import { formatPrice } from "../../lib/money";

const VARIANT_FIELDS = gql(`
  fragment VariantFields on ProductVariant {
    id
    title
    availableForSale
    selectedOptions {
      name
      value
    }
    price {
      amount
      currencyCode
    }
    compareAtPrice {
      amount
      currencyCode
    }
    image {
      url
      altText
    }
    product {
      title
      handle
    }
    sku
  }
`);

const PRODUCT_QUERY = gql(
  `
  query Product(
    $handle: String!
    $selectedOptions: [SelectedOptionInput!]!
    $country: CountryCode
    $language: LanguageCode
  ) @inContext(country: $country, language: $language) {
    product(handle: $handle) {
      id
      handle
      title
      vendor
      descriptionHtml
      requiresSellingPlan
      priceRange {
        minVariantPrice {
          amount
          currencyCode
        }
        maxVariantPrice {
          amount
          currencyCode
        }
      }
      featuredImage {
        url
        altText
      }
      images(first: 10) {
        nodes {
          url
          altText
        }
      }
      encodedVariantExistence
      encodedVariantAvailability
      options {
        name
        optionValues {
          name
          firstSelectableVariant {
            ...VariantFields
          }
        }
      }
      selectedOrFirstAvailableVariant(
        selectedOptions: $selectedOptions
        ignoreUnknownOptions: true
        caseInsensitiveMatch: true
      ) {
        ...VariantFields
      }
      adjacentVariants(
        selectedOptions: $selectedOptions
        ignoreUnknownOptions: true
        caseInsensitiveMatch: true
      ) {
        ...VariantFields
      }
    }
  }
`,
  [VARIANT_FIELDS],
);

const selectedOptions = getSelectedProductOptions(Astro.url);

const { data, errors } = await Astro.locals.storefront.graphql(PRODUCT_QUERY, {
  variables: {
    handle: Astro.params.handle!,
    selectedOptions,
  },
});

if (errors) {
  console.error("[hydrogen] Product query failed", errors);
  throw new Response("Product query failed", { status: 500 });
}
if (!data?.product) {
  throw new Response("Product not found", { status: 404 });
}

const product = data.product;
const variant = product.selectedOrFirstAvailableVariant ?? null;
const selectedMap = new Map(selectedOptions.map((o) => [o.name, o.value]));
---

<Layout title={`${product.title} — Hydroflare`}>
  <main class="container">
    <div class="pdp">
      <div class="pdp__media">
        {
          product.featuredImage?.url ? (
            <img
              src={product.featuredImage.url}
              alt={product.featuredImage.altText ?? product.title}
            />
          ) : (
            <span class="pdp__placeholder" />
          )
        }
      </div>

      <div class="pdp__detail">
        <h1 class="pdp__title">{product.title}</h1>

        <div id="product-price" class="pdp__price">
          {variant?.price ? formatPrice(variant.price) : formatPrice(product.priceRange.minVariantPrice)}
          {variant?.compareAtPrice && (
            <s class="price__compare"> {formatPrice(variant.compareAtPrice)}</s>
          )}
        </div>

        {product.descriptionHtml && (
          <div class="pdp__desc" set:html={product.descriptionHtml} />
        )}

        <div id="product-options" class="pdp__options">
          {
            product.options?.map((opt) => (
              <fieldset class="option">
                <legend>{opt.name}</legend>
                <div class="option__values">
                  {opt.optionValues?.map((v) => {
                    const cross =
                      v.firstSelectableVariant?.product?.handle &&
                      v.firstSelectableVariant.product.handle !== product.handle;
                    return (
                      <a
                        class:list={[
                          "option__value",
                          selectedMap.get(opt.name) === v.name && "is-selected",
                        ]}
                        href={`?${encodeURIComponent(opt.name)}=${encodeURIComponent(v.name)}`}
                        data-option-name={opt.name}
                        data-option-value={v.name}
                        data-cross-product={cross ? "true" : "false"}
                      >
                        {v.name}
                      </a>
                    );
                  })}
                </div>
              </fieldset>
            ))
          }
        </div>

        <div id="product-buy" class="pdp__buy">
          <form class="buy-form" method="post" action="/api/cart" data-product-form>
            <input type="hidden" name="merchandiseId" value={variant?.id ?? ""} />
            <label class="buy-form__qty">
              Qty
              <input type="number" name="quantity" value="1" min="1" step="1" />
            </label>
            <button
              class="btn"
              type="submit"
              name="intent"
              value="add"
              disabled={!variant || !variant.availableForSale || product.requiresSellingPlan}
            >
              {!variant
                ? "Select options"
                : !variant.availableForSale
                  ? "Sold out"
                  : "Add to cart"}
            </button>
          </form>
        </div>
      </div>
    </div>
    <div
      id="product-analytics"
      data-id={product.id}
      data-title={product.title}
      data-vendor={product.vendor ?? ""}
      data-price={variant?.price?.amount ?? product.priceRange.minVariantPrice.amount}
      data-variant-id={variant?.id ?? product.id}
      data-variant-title={variant?.title ?? product.title}
      data-sku={variant?.sku ?? ""}
      hidden
    >
    </div>
  </main>
</Layout>

<script is:inline define:vars={{ PRODUCT: product }}>
  window.__PRODUCT__ = PRODUCT;
</script>

<script>
  import { mountProduct } from "../../scripts/product";
  import { initAnalyticsFromDom, getAnalytics, AnalyticsEvent } from "../../lib/analytics";

  mountProduct((window as any).__PRODUCT__, {
    options: document.getElementById("product-options")!,
    price: document.getElementById("product-price")!,
    buy: document.getElementById("product-buy")!,
  });

  // Publish product_viewed (Shopify GIDs required for Monorail).
  const shop = initAnalyticsFromDom();
  const analytics = getAnalytics();
  const el = document.getElementById("product-analytics");
  if (el && analytics && shop) {
    const d = el.dataset;
    analytics.publish(AnalyticsEvent.PRODUCT_VIEWED, {
      products: [
        {
          id: d.id ?? "",
          title: d.title ?? "",
          price: d.price ?? "",
          vendor: d.vendor ?? "",
          variantId: d.variantId ?? d.id ?? "",
          variantTitle: d.variantTitle ?? d.title ?? "",
          quantity: 1,
          sku: d.sku || undefined,
        },
      ],
      url: window.location.href,
      shop,
    });
  }
</script>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
  }
  .pdp {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  @media (max-width: 720px) {
    .pdp {
      grid-template-columns: 1fr;
    }
  }
  .pdp__media,
  .pdp__placeholder {
    aspect-ratio: 1 / 1;
    background: #fafafa;
    border-radius: 8px;
    overflow: hidden;
  }
  .pdp__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pdp__title {
    font-size: 1.6rem;
    margin: 0 0 0.5rem;
  }
  .pdp__price {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  :global(.price__compare) {
    color: #999;
    text-decoration: line-through;
    font-weight: 400;
    font-size: 1rem;
    margin-left: 0.4rem;
  }
  .pdp__desc {
    color: #444;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }
  .pdp__desc :global(p) {
    margin: 0 0 0.75rem;
  }
  .pdp__options {
    margin-bottom: 1.5rem;
  }
  :global(.option) {
    border: 0;
    padding: 0;
    margin: 0 0 1rem;
  }
  :global(.option legend) {
    font-weight: 600;
    font-size: 0.85rem;
    margin-bottom: 0.4rem;
  }
  :global(.option__values) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  :global(.option__value) {
    display: inline-block;
    padding: 0.4rem 0.8rem;
    border: 1px solid #ccc;
    border-radius: 6px;
    text-decoration: none;
    color: #333;
    cursor: pointer;
    font-size: 0.9rem;
  }
  :global(.option__value.is-selected) {
    border-color: #111;
    background: #111;
    color: #fff;
  }
  :global(.option__value.is-soldout) {
    opacity: 0.6;
  }
  :global(.option__value.is-disabled) {
    opacity: 0.3;
    pointer-events: none;
  }
  :global(.option__soldout) {
    font-size: 0.75rem;
  }
  :global(.buy-form) {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  :global(.buy-form__qty input) {
    width: 56px;
    padding: 0.4rem;
    font: inherit;
  }
  :global(.buy-form__error) {
    color: #b00020;
    font-size: 0.85rem;
    flex-basis: 100%;
    margin: 0.5rem 0 0;
  }
</style>
