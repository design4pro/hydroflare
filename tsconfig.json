{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    // Verification scripts run via tsx and depend on codegen output
    // (src/lib/shopify/generated/**), which is produced by `npm run codegen`
    // after the Storefront token is configured. Excluded from `astro check`
    // until generated types are committed; CI runs them via tsx.
    "scripts"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
